From 44339a2ca2b3956cff7b9ebaf5159d037559f3fd Mon Sep 17 00:00:00 2001
From: manshiangli <liminxiang@testin.cn>
Date: Mon, 3 Aug 2026 10:13:58 +0800
Subject: [PATCH] chore: backport to Swift 5.7 compatibility

- Lower swift-tools-version from 5.9 to 5.7
- Remove visionOS platform (not available in Swift 5.7)
- Swap swift-argument-parser to local path dependency
- Remove borrowing keyword (Swift 5.9+ only)
- Comment out #Preview macros (Swift 5.9+ only)
- Replace if-expression with ternary operator (Swift 5.9+ only)
- Replace clipsToBounds with wantsLayer (macOS 14+ API)
- Adapt UnsafeMutableBufferPointer 5.9 APIs to 5.7 equivalents:
  initialize(fromContentsOf:) -> initialize(from: UnsafeBufferPointer(...))
  deinitialize() -> baseAddress?.deinitialize(count:)
  update(repeating:) -> manual for-loop
---
 Package.swift                                 |  7 +++---
 .../SwiftTerm/Apple/AppleTerminalView.swift   |  5 ++++-
 Sources/SwiftTerm/BufferLine.swift            | 22 +++++++++----------
 Sources/SwiftTerm/Mac/MacTerminalView.swift   |  4 +++-
 Sources/SwiftTerm/SelectionService.swift      |  6 +----
 Sources/SwiftTerm/Terminal.swift              | 16 +++++++-------
 Sources/SwiftTerm/iOS/iOSTerminalView.swift   |  5 +++++
 7 files changed, 35 insertions(+), 30 deletions(-)

diff --git a/Package.swift b/Package.swift
index 3750179..3378e96 100644
--- a/Package.swift
+++ b/Package.swift
@@ -1,4 +1,4 @@
